{
  "name": "audio-recorder-splitter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run copy:ffmpeg-core",
    "dev": "vite",
    "prebuild": "npm run copy:ffmpeg-core",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0 --port 5177",
    "test": "vitest run",
    "test:watch": "vitest",
    "copy:ffmpeg-core": "node scripts/copy-ffmpeg-core.mjs",
    "postinstall": "npm run copy:ffmpeg-core"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "jszip": "3.10.2",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
